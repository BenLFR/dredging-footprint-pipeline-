# Generic cluster overrides for pipeline wrappers (Step 4-7).
# Usage:
#   cp config/templates/slurm/cluster_overrides.env.example config/local/cluster_overrides.env
#   source config/local/cluster_overrides.env

# Canonical runtime paths
export PIPELINE_DIR="/path/to/Master-thesis-code-"
export SCRATCH_DIR="/path/to/scratch"
export OUTPUT_DIR="$SCRATCH_DIR/output_V6"
export CONFIG_DIR="$SCRATCH_DIR/configuration"
export LOGS_DIR="$PIPELINE_DIR/logs"

# Optional tool/library overrides
export R_LIBS_USER="$HOME/R/library"

# Optional sbatch routing flags (used by submit_step.sh)
# Leave empty if not needed on your cluster.
export SBATCH_PARTITION=""
export SBATCH_ACCOUNT=""
export SBATCH_QOS=""
export SBATCH_CONSTRAINT=""
export SBATCH_EXCLUDE=""
export SBATCH_NODELIST=""
