# GRIT cluster configuration for pipeline_repro end-to-end test (pub/v1.0-clean)
# Usage: bash deploy/run_full_pipeline.sh --env-file deploy/config.grit.env
#
# Before using:
#   1. Set HPC_HOST to the GRIT hostname (from your SSH config)
#   2. Set AIS_INPUT_FILE to the actual path of the filtered AIS CSV on GRIT
#   3. Run: bash deploy/hpc_sync.sh --env-file deploy/config.grit.env
#      to push the pub/v1.0-clean code to pipeline_repro/ on GRIT
#   4. Run: bash deploy/run_full_pipeline.sh --env-file deploy/config.grit.env

# SSH target (matches ~/.ssh/config entry for GRIT)
HPC_HOST=grit
HPC_USER=bloe

# Remote project layout
# pipeline_repro/ = the pub/v1.0-clean test directory (separate from pipeline_V6/)
HPC_BASEDIR=/home/bloe/ais-pipeline/pipeline_repro
HPC_SCRATCH=/home/bloe/scratch
REMOTE_LOG_DIR=${HPC_BASEDIR}/logs
PIPELINE_DIR_REMOTE=${HPC_BASEDIR}/pipeline
PIPELINE_WORK_ROOT_REMOTE=${HPC_SCRATCH}

# Runtime pipeline variables (forwarded to every SLURM job)
PIPELINE_DIR=${HPC_BASEDIR}/pipeline
SCRATCH_DIR=${HPC_SCRATCH}
CONFIG_DIR=${HPC_SCRATCH}/configuration
OUTPUT_DIR=${HPC_SCRATCH}/output_V6_repro
# Set AIS_INPUT_FILE to the actual GFW AIS data path on GRIT scratch:
AIS_INPUT_FILE=${HPC_SCRATCH}/AIS_data/ais_filtered.csv

# SLURM partition for GRIT (R is only available on emlab_nodes)
SLURM_PARTITION=emlab_nodes
SLURM_ACCOUNT=

# Sync items to push to pipeline_repro/
SYNC_ITEMS="deploy pipeline config documentation tests data/toy postproc README.md LICENSE THIRD_PARTY_NOTICES.md CITATION.cff requirements.txt renv.lock"
FETCH_ITEMS="output_V6_repro logs"
