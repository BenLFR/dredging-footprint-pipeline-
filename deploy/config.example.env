# Copy this file to deploy/config.env and adapt values for your site.

# SSH target. Leave HPC_USER empty if your SSH config already defines the user.
HPC_HOST=cluster.example.org
HPC_USER=

# Remote project paths.
HPC_BASEDIR=/path/to/project-root
HPC_SCRATCH=/scratch/${USER}/project-name
REMOTE_LOG_DIR=${HPC_BASEDIR}/logs
PIPELINE_DIR_REMOTE=${HPC_BASEDIR}/pipeline
PIPELINE_WORK_ROOT_REMOTE=${HPC_SCRATCH}

# Runtime pipeline variables forwarded to every SLURM job.
# These override the defaults derived from HPC_BASEDIR/HPC_SCRATCH above.
# Uncomment and set for non-standard layouts (e.g. pipeline_repro test run).
#PIPELINE_DIR=${HPC_BASEDIR}/pipeline_repro/pipeline
#SCRATCH_DIR=${HPC_SCRATCH}
#CONFIG_DIR=${HPC_SCRATCH}/configuration
#OUTPUT_DIR=${HPC_SCRATCH}/output_V6
#AIS_INPUT_FILE=${HPC_SCRATCH}/AIS_data/ais_filtered.csv
STEP6_CARBON_REMOTE_DIR=${PIPELINE_WORK_ROOT_REMOTE}/configuration/atwood_carbon_full
STEP6_TRAWLING_HISTORY_REMOTE_PATH=${PIPELINE_WORK_ROOT_REMOTE}/configuration/trawling_history.rds
STEP7_OCIM_REMOTE_DIR=${PIPELINE_WORK_ROOT_REMOTE}/configuration/ocim
POSTPROC_REMOTE_DIR=${HPC_BASEDIR}/postproc

# Optional stage-out and cleanup defaults used by deploy/cleanup_scratch.sh.
# Each stage-out item is SOURCE:DEST, where SOURCE is resolved under HPC_SCRATCH
# unless absolute, and DEST is resolved under HPC_BASEDIR unless absolute.
SCRATCH_STAGE_OUT_ITEMS=""
SCRATCH_CLEANUP_ITEMS=""

# Optional SSH settings.
SSH_CONFIG_FILE=
SSH_KEY_PATH=
RSYNC_RSH=

# Optional scheduler defaults.
SLURM_PARTITION=
SLURM_ACCOUNT=
SLURM_QOS=
SBATCH_EXPORT=ALL

# Default sync and fetch sets. Space-separated paths relative to the repository root.
SYNC_ITEMS="deploy pipeline config documentation tests data/toy postproc README.md LICENSE THIRD_PARTY_NOTICES.md CITATION.cff requirements.txt renv.lock"
FETCH_ITEMS="output_V6 logs documentation"