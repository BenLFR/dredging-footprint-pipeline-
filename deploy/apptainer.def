Bootstrap: docker
From: rocker/r-ver:4.4.1

%labels
    Author BenLFR
    Description "Global dredging footprint pipeline reproducible runtime"
    Version "v1.0-clean"

%help
    Build:
      apptainer build ais-pipeline.sif deploy/apptainer.def

    Run:
      apptainer exec ais-pipeline.sif Rscript tests/smoke_test_steps3_6_entrypoints.R

%files
    renv.lock /opt/ais-pipeline/renv.lock
    requirements.txt /opt/ais-pipeline/requirements.txt

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONUNBUFFERED=1

%post
    set -eux

    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
        python3-pip \
        python3-venv \
        python3-dev \
        gcc \
        g++ \
        gfortran \
        make \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        libgdal-dev \
        libgeos-dev \
        libproj-dev \
        libudunits2-dev \
        libsqlite3-dev \
        libgl1 \
        libglib2.0-0

    rm -rf /var/lib/apt/lists/*

    R -q -e "install.packages('renv', repos='https://cloud.r-project.org')"
    R -q -e "renv::consent(provided = TRUE); renv::restore(lockfile='/opt/ais-pipeline/renv.lock', prompt=FALSE)"

    python3 -m pip install --no-cache-dir --upgrade pip
    python3 -m pip install --no-cache-dir -r /opt/ais-pipeline/requirements.txt

    mkdir -p /workspace

%runscript
    exec "$@"

